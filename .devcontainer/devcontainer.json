{
  "name": "Banking analytics — Codespaces",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    4040,
    8088,
    9870,
    18080
  ],
  "portsAttributes": {
    "4040": {
      "label": "Spark live UI",
      "onAutoForward": "notify"
    },
    "8088": {
      "label": "YARN ResourceManager",
      "onAutoForward": "notify"
    },
    "9870": {
      "label": "HDFS NameNode",
      "onAutoForward": "notify"
    },
    "18080": {
      "label": "Spark History Server",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.codespaces-state/venv/bin/python"
      }
    }
  },
  "postCreateCommand": "bash scripts/codespaces/check_host.sh",
  "remoteUser": "vscode"
}
